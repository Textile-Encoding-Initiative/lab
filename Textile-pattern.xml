<TEI xmlns="http://www.tei-c.org/ns/1.0">
   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Textile Encoding Initiative Playground</title>
            <respStmt>
               <resp>Conceptualisation and encoding</resp>
               <name>Elisa Cugliana</name>
            </respStmt>
         </titleStmt>
         <publicationStmt>
            <p>Experimental file, version 0.1.</p>
         </publicationStmt>
         <sourceDesc>
            <p>Facsimile of a printed knitting pattern with handwritten annotations</p>
         </sourceDesc>
      </fileDesc>
      <encodingDesc>
         <p>TEI records the document and its evidence; Textile elements model
            executable knitting instructions. </p>
         
         <classDecl>
            <taxonomy xml:id="operations">
               <category xml:id="op-knit">
                  <catDesc>Knit</catDesc>
               </category>
               <category xml:id="op-purl">
                  <catDesc>Purl</catDesc>
               </category>
               <category xml:id="op-k2tog">
                  <catDesc>Knit two together</catDesc>
               </category>
               <category xml:id="op-yo">
                  <catDesc>Yarn over</catDesc>
               </category>
            </taxonomy>
            
            <taxonomy xml:id="marginalia">
               <category xml:id="adaptation">
                  <catDesc>These annotations regard the adaptation of the pattern based on gauge or size differences</catDesc>
               </category>
               <category xml:id="specification">
                  <catDesc>These annotations specify aspects of the pattern further</catDesc>
               </category>
               <category xml:id="corrections">
                  <catDesc>These annotations correct mistakes or inconsistencies in the pattern</catDesc>
               </category>
               <category xml:id="counting">
                  <catDesc>These annotations reflect counting practices of the knitter, for example when she is keeping track of the point she got to</catDesc>
               </category>
            </taxonomy>
         </classDecl>
      </encodingDesc>
      
      <profileDesc>
         <handNotes>
            <handNote xml:id="hand1">Elisa Cugliana</handNote>
         </handNotes>
      </profileDesc>
